# Jornada Intensiva — exemplo de variáveis locais.
# Copie para .env.local e preencha. NÃO COMMITAR .env.local.

# Provider de IA: 'openai' | 'heuristic'
#   heuristic — Fase 1 sem LLM (fallback determinístico)
#   openai    — Fase 2 com OpenAI
AI_PROVIDER=heuristic

# OpenAI (obrigatório se AI_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-4.1

# Futuro (Fase 3+):
# ANTHROPIC_API_KEY=sk-ant-XXXX
# GEMINI_API_KEY=XXXX
