{
  "name": "jornada-intensiva",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "start:lan": "next start --hostname 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/lib/db/seed.ts",
    "smoke:llm": "tsx --env-file=.env.local scripts/smoke-llm.ts",
    "ip": "node -e \"const os=require('os');const n=os.networkInterfaces();for(const k of Object.keys(n)){for(const x of n[k]){if(x.family==='IPv4'&&!x.internal)console.log(k+': http://'+x.address+':3000')}}\""
  },
  "dependencies": {
    "better-sqlite3": "11.7.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.38.3",
    "nanoid": "5.0.9",
    "next": "15.1.4",
    "openai": "^6.37.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "0.30.1",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.4",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
